    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.12",
    "pino-pretty": "^11.2.2",
    "sequelize-cli": "^6.6.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
